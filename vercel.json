{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/webhook/:path*",
      "destination": "/api/webhook"
    },
    {
      "source": "/",
      "destination": "/api"
    }
  ]
}
